{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "techlords-resources",
  "account_id": "1bcae35736ae21eb51be21e8e6798190",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "techlord.wordlordmedia.com",
      "custom_domain": true
    }
  ],
  "main": "src/worker.mjs",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
